{
  "name": "proofroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.15.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "compact": "compact compile compact/proofroom.compact compact/managed",
    "pilot:wallets": "node scripts/generate-pilot-wallets.mjs",
    "pilot:stress": "node scripts/run-preprod-stress-test.mjs",
    "pilot:dust-sync": "node scripts/sync-preprod-dust.mjs",
    "pilot:verify": "node scripts/verify-preprod-transactions.mjs",
    "pilot:deploy": "node scripts/deploy-proofroom-preprod.mjs deploy",
    "pilot:app": "node scripts/deploy-proofroom-preprod.mjs create-listing",
    "pilot:app:all": "node scripts/run-preprod-application-pass.mjs",
    "pilot:register-dust": "node scripts/deploy-proofroom-preprod.mjs register-dust",
    "pilot:verify-app": "node scripts/verify-preprod-application.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.0.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.1",
    "@midnight-ntwrk/wallet-sdk-node-client": "1.1.0",
    "@midnight-ntwrk/wallet-sdk-prover-client": "1.2.0",
    "@midnight-ntwrk/wallet-sdk-shielded": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "2.1.0",
    "@polkadot/api": "16.5.6",
    "@vitejs/plugin-react": "6.1.1",
    "graphql-ws": "6.2.1",
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "30.0.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.1.0"
  }
}
